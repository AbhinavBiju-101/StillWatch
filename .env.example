# Copy to .env (never commit .env). Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxx.supabase.co:5432/postgres
DEVICE_TOKEN=
DEMO_PASSWORD=
TESTING_PASSWORD=

# none | gemini | ollama
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# 1 when served over HTTPS (Render)
COOKIE_SECURE=0
BEHIND_PROXY=0   # 1 on Render

# One-click sign-in buttons on the home page.
# Demo only shows simulated data, so it is safe to leave on.
QUICK_LOGIN_DEMO=1
# Testing opens the REAL pilot data with no password. Use 1 only on your own machine, never on a public deployment.
QUICK_LOGIN_TESTING=0

# SMS / WhatsApp alerts for pilot tanks (none | twilio). Add contacts on the Alerts > Notifications page.
NOTIFY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
PUBLIC_BASE_URL=

# Devices. Give each node its own token:  python -m flask --app app register-device tank-hostel-01
# The shared DEVICE_TOKEN above keeps working for nodes without one; set 0 to refuse it.
ALLOW_SHARED_DEVICE_TOKEN=1
# Lets an uptime pinger (or cron) call POST /api/sweep with header X-Sweep-Token to flag silent devices. Empty = off.
SWEEP_TOKEN=
DEVICE_SILENT_MIN=30
# Periods the nodes are told to use at check-in (seconds)
DEVICE_READ_PERIOD_S=10
DEVICE_SEND_PERIOD_S=60
MAX_UPLOAD_MB=6
